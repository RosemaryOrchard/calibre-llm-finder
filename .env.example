# Copy to .env and adjust. All settings are also overridable via real
# environment variables with the same CLF_ prefix.

# Path to the root of your Calibre library (the folder containing metadata.db).
CLF_CALIBRE_LIBRARY_PATH=/Users/you/Calibre Library

# Where this tool stores its own derived index — never mixed with Calibre's data.
CLF_DATA_DIR=/Users/you/.calibre_llm_finder

# Local Ollama server + models.
CLF_OLLAMA_HOST=http://localhost:11434
CLF_EMBEDDING_MODEL=nomic-embed-text
CLF_CHAT_MODEL=llama3.1
CLF_EMBEDDING_DIMENSIONS=768

# How many concurrent embedding requests to send to Ollama while indexing.
CLF_EMBEDDING_CONCURRENCY=8

CLF_SEARCH_CANDIDATE_COUNT=20
CLF_SEARCH_RESULT_COUNT=5
CLF_REQUEST_TIMEOUT_SECONDS=60
